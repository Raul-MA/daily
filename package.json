{
  "name": "daily-pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test:all": "node scripts/test.mjs all",
    "test:general": "node scripts/test.mjs general",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "verify": "npm run lint && npm run check:js && npm run test:all && npm run build",
    "test:plants": "node scripts/test.mjs plants",
    "test:coffee": "node scripts/test.mjs coffee",
    "test:games": "node scripts/test.mjs games",
    "test:time-budget": "node scripts/test.mjs time-budget",
    "test:piano": "node scripts/test.mjs piano",
    "test:whatsapp": "node scripts/test.mjs whatsapp",
    "test:reading": "node scripts/test.mjs reading",
    "prepare:legacy-workers": "node scripts/prepare-legacy-workers.mjs",
    "prepare:legacy-budget": "node scripts/prepare-legacy-budget.mjs",
    "check:js": "node scripts/check-js.mjs"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "@playwright/test": "1.61.0"
  }
}
